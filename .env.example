# ScoreLive local env example

# Required on Vercel / production (min 32 characters). Fail-closed if missing.
TURNYFLY_SESSION_SECRET=replace-with-a-long-random-secret-value

# Canonical site URL for Open Graph / shares
NEXT_PUBLIC_SITE_URL=https://scorelive-app.vercel.app

# Built-in demo admin is OFF in production unless explicitly enabled.
# Local `next dev` enables demo admin by default (admin / turnyfly-demo).
# DEMO_ADMIN_ENABLED=true

# Optional demo admin overrides (local only)
# TURNYFLY_ADMIN_USERNAME=admin
# TURNYFLY_ADMIN_PASSWORD_HASH=
