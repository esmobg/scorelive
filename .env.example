# ScoreLive local env example
# Copy to .env.local for local development.

# Required on Vercel / production (min 32 characters). Fail-closed if missing.
TURNYFLY_SESSION_SECRET=replace-with-a-long-random-secret-value

# Canonical site URL for Open Graph / shares / password-reset links
NEXT_PUBLIC_SITE_URL=https://scorelive-app.vercel.app

# Turso (libSQL) — required for shared auth/tournaments/favorites in production.
# Local/dev falls back to file:.data/scorelive.db when unset.
# TURSO_DATABASE_URL=libsql://scorelive-<org>.turso.io
# TURSO_AUTH_TOKEN=

# Built-in demo admin is OFF in production unless explicitly enabled.
# Local `next dev` enables demo admin by default (admin / turnyfly-demo).
# DEMO_ADMIN_ENABLED=true

# Optional demo admin overrides (local only)
# TURNYFLY_ADMIN_USERNAME=admin
# TURNYFLY_ADMIN_PASSWORD_HASH=

# ---------------------------------------------------------------------------
# Password-reset email (optional — leave unset for log-only delivery)
# ---------------------------------------------------------------------------
# Without these, forgot-password still works: a hashed token is stored and
# the reset URL is written to server logs (Vercel → Logs). That is the
# current production behavior until keys are added.
#
# Exact Vercel env names (Production + Preview):
#   RESEND_API_KEY          — API key from https://resend.com
#   RESEND_FROM_EMAIL       — preferred from, e.g. ScoreLive <noreply@your-domain>
#   RESEND_FROM             — alias for RESEND_FROM_EMAIL
#   EMAIL_FROM              — second alias for the from address
#
# Setup later (when you have a Resend key + verified from domain):
#   printf '%s' 're_...' | npx vercel env add RESEND_API_KEY production --scope esmobgs-projects --project scorelive
#   printf '%s' 're_...' | npx vercel env add RESEND_API_KEY preview --scope esmobgs-projects --project scorelive
#   printf '%s' 'ScoreLive <noreply@your-domain>' | npx vercel env add RESEND_FROM_EMAIL production --scope esmobgs-projects --project scorelive
#   printf '%s' 'ScoreLive <noreply@your-domain>' | npx vercel env add RESEND_FROM_EMAIL preview --scope esmobgs-projects --project scorelive
#   npx vercel deploy --prod --yes --scope esmobgs-projects --project scorelive
#
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=ScoreLive <noreply@your-domain.example>
# RESEND_FROM=
# EMAIL_FROM=
